### --- Create Heimathafen Neukölln event source ---
# Links the venue to the HeimathafenWebsiteImporter.
# The sourceType "HEIMATHAFEN" matches EventSource.HEIMATHAFEN.
# NOTE: the URL is the WP REST base for the ACF-backed `events` post type — a JSON source, no HTML
# scraping (ADR-007 priority 1). One post holds an `acf.event_performances` array, so each dated
# performance becomes its own event. The endpoint serves the whole archive and cannot filter on the
# ACF date, so the importer walks its ~5 pages and drops past performances while parsing.
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{heimathafen_venue_id}},
    "name": "Heimathafen Neukölln",
    "url": "https://heimathafen-neukoelln.de/wp-json/wp/v2/events",
    "sourceType": "HEIMATHAFEN",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("Heimathafen Neukölln event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

