### --- Create Havanna event source ---
# Links the venue to the HavannaWebsiteImporter.
# The sourceType "HAVANNA" matches EventSource.HAVANNA.
# Havanna publishes no dates at all: the importer reads the three undated weekly night pages
# (/wednesday, /friday, /saturday) linked from /events and derives one dated occurrence per week
# over a rolling 8-week horizon. Each run regenerates that window, so events shift forward daily
# and stale ones are cleaned up automatically — hence the daily interval like every other source.
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{havanna_venue_id}},
    "name": "Havanna",
    "url": "https://www.havanna-berlin.de/events",
    "sourceType": "HAVANNA",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("Havanna event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
