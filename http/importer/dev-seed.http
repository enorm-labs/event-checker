### ============================================================
### Dev Seed — bootstrap local database with venues & sources
###
### Run all requests in this file sequentially (▶▶ "Run All")
### after starting the importer with a fresh database.
### Requests are idempotent-safe: duplicates will return 409.
###
### Import triggers are asynchronous: each returns 202 Accepted immediately and the
### import runs in the background, so events keep landing for up to ~a minute after the
### run finishes. Poll `GET /api/admin/event-sources` to watch each source's status.
###
### Sources (alphabetical):
###   ÆDEN                 — https://aedenberlin.com/events/ (WordPress techno club; entry → /month/?month=YYYY-MM pages)
###   Alte Kantine         — https://alte-kantine.eu/ (WordPress Content Views grid, list + detail)
###   AMT                  — https://www.club-amt.berlin/events (Webflow techno club; entry → /month/<name> pages)
###   Arcanoa              — https://www.ssi-media.com/arcanoa/veranst.htm (1990s hand-coded single-page programme)
###   arkaoda              — https://berlin.arkaoda.com/?/default/program (hand-coded PHP; list + detail)
###   Astra Kulturhaus     — https://www.astra-berlin.de/
###   Badehaus             — https://badehaus-berlin.com/events/
###   Bar jeder Vernunft   — https://www.bar-jeder-vernunft.de/de/programm/kalender.html (Neos CMS; per-date JSON-LD + show pages)
###   Berghain             — https://www.berghain.berlin/de/program/ (server-rendered; list + detail)
###   Bi Nuu               — https://binuu.de/de/events
###   Cassiopeia           — https://cassiopeia-berlin.de/club
###   Clash                — https://clash-berlin.de/
###   Club der Visionäre   — https://clubdervisionaere.com/programm/ (WordPress; one listing, three rooms by colour class)
###   Columbia Theater     — https://columbia-theater.de/ (WordPress; homepage listing + /event/YYYYMMDD-<slug> detail pages)
###   Columbiahalle        — https://www.columbiahalle.berlin/veranstaltungen.html (Contao; single-page listing, month headings)
###   Duncker Club         — https://www.dunckerclub.de/start.html
###   Festsaal Kreuzberg   — https://festsaal-kreuzberg.de/de/programm/ (Wagtail CMS JSON API)
###   Frannz Club          — https://frannz.eu/
###   Golden Gate          — https://goldengate-berlin.de/ (WordPress/Elementor; current Thu–Sat block only)
###   Gretchen             — https://www.gretchen-club.de/
###   Havanna              — https://www.havanna-berlin.de/events (undated weekly nights, expanded to dated occurrences)
###   Heimathafen Neukölln — https://heimathafen-neukoelln.de/wp-json/wp/v2/events (WP REST + ACF; performances array)
###   Hole 44              — https://hole-berlin.de/events/ (WordPress/Events-Manager, list + detail)
###   Junction Bar         — https://www.junction-bar.de/ (live music + DJ programs)
###   Kantine am Berghain  — https://www.berghain.berlin/de/program/kantine-am-berghain/ (shares BERGHAIN importer)
###   Lido                 — https://www.lido-berlin.de/
###   Loge                 — https://www.loge-berlin.org/event-list (Wix Events warmup JSON + JSON-LD price)
###   Madame Claude        — https://madameclaude.de/ (WordPress `event` REST API, ACF-backed)
###   Matrix               — https://www.matrix-berlin.de/party-in-berlin/ (WordPress; entry → per-month pages)
###   Mikropol             — https://mikropol-berlin.de/events/ (WordPress/Events-Manager, list + detail)
###   Monarch              — https://kottimonarch.de/programm.php (retro PHP single-page listing)
###   MS Hoppetosse        — https://hoppetosse.berlin/program/ (shares the CLUB_DER_VISIONAERE listing; winter location)
###   Neue Zukunft         — https://neue-zukunft.org/ (Elfsight Event Calendar widget JSON API)
###   Privatclub           — https://privatclub-berlin.de/
###   Roadrunner's Paradise — http://www.roadrunners-paradise.de/programm.html
###   Schokoladen          — https://www.schokoladen-mitte.de/
###   SO36                 — https://www.so36.com/tickets
###   Soda Club            — https://www.soda-berlin.de/events (disco2app CMS; list + detail with MusicEvent JSON-LD)
###   Sonnenraum           — https://clubdervisionaere.com/programm/ (shares the CLUB_DER_VISIONAERE listing)
###   Supamolly            — https://www.supamolly.de/?p=programm (retro PHP single-page listing; row id = date stamp)
###   Urban Spree          — https://www.urbanspree.com/program/ (MODX; descending paginated list + detail)
###   Wild at Heart        — https://www.wildatheartberlin.de/concerts.php (retro frameset single-page listing)
###   Zenner               — https://zenner.berlin/programm (Gatsby/Sanity; page-data.json artefact)
### ============================================================

### ————————————————————————————————————————————————————————————
### ÆDEN (Schleusenufer 3, Berlin-Kreuzberg — on the Spree)
### ————————————————————————————————————————————————————————————

### --- Create ÆDEN venue ---
POST {{importer-host}}/api/admin/venues
Content-Type: application/json

{
    "name": "ÆDEN",
    "address": "Schleusenufer 3",
    "city": "Berlin",
    "postalCode": "10997",
    "district": "friedrichshain-kreuzberg",
    "latitude": 52.49731,
    "longitude": 13.44952,
    "websiteUrl": "https://aedenberlin.com",
    "description": "A techno club on the Spree in Kreuzberg with two floors and a garden, programming house, techno and trance nights alongside queer and collective-run parties."
}

> {%
    client.global.set("aeden_venue_id", response.body.id);
    client.test("ÆDEN venue created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Create ÆDEN event source ---
# Links the venue to the AedenWebsiteImporter.
# The sourceType "AEDEN" matches EventSource.AEDEN.
# The URL is the `/events/` month index; the importer follows every `a.month-button`
# to its server-rendered `/month/?month=YYYY-MM` page.
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{aeden_venue_id}},
    "name": "ÆDEN",
    "url": "https://aedenberlin.com/events/",
    "sourceType": "AEDEN",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("ÆDEN event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Trigger initial ÆDEN import ---
POST {{importer-host}}/api/admin/event-sources/aeden/import
Accept: application/json

> {%
    client.test("ÆDEN import triggered", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

