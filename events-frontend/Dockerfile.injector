# events-frontend — the meta-injection sidecar (ADR-014 §Decision 3), a second container in the
# frontend pod that fills the head of `index.html` per detail page for the scrapers that run no
# JavaScript. See injector/server.ts for what it does and what it refuses to do.
#
# Same rules as the frontend Dockerfile beside it, and for the same reasons: no builder stage and
# no `RUN` that does build work, so one runner emits both platforms. `npm run build` produces
# `dist-injector/injector.mjs` — one file, every import inlined — and this copies it:
#
#     npm --prefix events-frontend ci && npm --prefix events-frontend run build
#     docker buildx build events-frontend -f events-frontend/Dockerfile.injector \
#       --platform linux/amd64,linux/arm64 --build-arg VERSION=… --build-arg REVISION=…
#
# Pinned by tag *and* digest, like every base image here; Dependabot's `docker` ecosystem updates
# both. `24-alpine` because Node 24 is the engine `package.json` declares, and the bundle targets
# it. Alpine for the same reason nginx is on it: fewer packages in the scan.
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf

ARG VERSION=unspecified
ARG REVISION=unknown

LABEL org.opencontainers.image.source="https://github.com/enorm-labs/event-junkie" \
      org.opencontainers.image.title="event-junkie-injector" \
      org.opencontainers.image.description="Fills the head of the Event Junkie web app per detail page, for link previews" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

ENV NODE_ENV=production

WORKDIR /app
COPY dist-injector/injector.mjs /app/injector.mjs

# The UID the chart's `security.runAsUser` names, shared by every workload; `scripts/uid-consistency.sh`
# asserts they agree. The process writes nothing, so a read-only root filesystem needs no /tmp.
USER 10001:10001

# Documentation only; the chart's `frontend.injector.port` is what binds. Above 1024, non-root.
EXPOSE 3000

# No HEALTHCHECK, as in the frontend Dockerfile: the chart's probes on /healthz are the definition.
ENTRYPOINT ["node", "/app/injector.mjs"]
